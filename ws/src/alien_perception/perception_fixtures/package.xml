<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
    <name>perception_fixtures</name>
    <version>0.1.0</version>
    <description>Deterministic 2D, 3D and mixed perception input fixtures</description>
    <maintainer email="dev@alien-scanner.com">Alien Scanner Team</maintainer>
    <license>Apache-2.0</license>

    <buildtool_depend>ament_cmake</buildtool_depend>
    <depend>geometry_msgs</depend>
    <depend>perception_core</depend>
    <depend>perception_interfaces</depend>
    <depend>rclcpp</depend>
    <depend>sensor_msgs</depend>
    <depend>std_msgs</depend>
    <depend>visualization_msgs</depend>
    <exec_depend>launch</exec_depend>
    <exec_depend>launch_ros</exec_depend>
    <exec_depend>perception_input_node</exec_depend>
    <exec_depend>rviz2</exec_depend>
    <exec_depend>tf2_ros</exec_depend>
    <test_depend>ament_cmake_gtest</test_depend>
    <test_depend>ament_cmake_pytest</test_depend>
    <test_depend>ament_cmake_ros</test_depend>
    <test_depend>launch_testing_ament_cmake</test_depend>
    <test_depend>nav_msgs</test_depend>
    <test_depend>rclpy</test_depend>
    <test_depend>tf2_msgs</test_depend>
    <test_depend>python3-pytest</test_depend>

    <export>
        <build_type>ament_cmake</build_type>
    </export>
</package>
